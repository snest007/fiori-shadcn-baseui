  "reactImplementationBoundary": {
    "automaticRules": "Shared DynamicPage uses the same measured-content T threshold; no upward-delta expansion and no 300ms suppression timer.",
    "manualRules": "Unpinned top collapse targets ceil(H); pinned collapse unpins and targets T. React retains its current position on mid-content expansion because its sticky header remains in normal flow, whereas UI5 moves Header content between scroll and title areas and offsets by ceil(H).",
