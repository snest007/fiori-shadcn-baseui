{
  "name": "fiori-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src vite.config.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "theme:extract": "node scripts/extract-sap-theme.mjs",
    "theme:check": "node scripts/extract-sap-theme.mjs --check",
    "foundation:build": "node scripts/build-fiori-foundation.mjs",
    "foundation:check": "node scripts/build-fiori-foundation.mjs --check",
    "registry:build": "node scripts/registry-build.mjs",
    "registry:check": "node scripts/registry-build.mjs --check",
    "registry:verify-consumer": "node scripts/registry-verify-consumer.mjs",
    "test:value-help-contract": "node --experimental-strip-types scripts/verify-value-help-contract.mjs",
    "test:value-help-conditions": "node --experimental-strip-types scripts/verify-value-help-conditions.mjs",
    "test:contracts": "node --experimental-strip-types --test scripts/verify-value-help-contract.mjs scripts/verify-value-help-conditions.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sap-theming/theming-base-content": "^11.36.5",
    "@tailwindcss/vite": "^4",
    "@ui5/webcomponents-icons": "^2.28.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
